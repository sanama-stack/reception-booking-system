# Environment
.env
.env.local
.env.*.local

# Java / Gradle
backend/build/
backend/.gradle/
backend/out/
*.class
*.jar
# The Gradle wrapper jar MUST be committed — without it `./gradlew` cannot bootstrap on a clean
# clone and CI fails on checkout. The leading **/ is load-bearing: a path without it is anchored
# to this file's directory and would not match backend/gradle/wrapper/.
!**/gradle/wrapper/gradle-wrapper.jar

# Node / Next.js
node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/.pnpm-store/
frontend/tsconfig.tsbuildinfo
frontend/playwright-report/
frontend/test-results/

# IDE
.idea/
*.iml

# .vscode is deliberately NOT ignored. The README documents `F5` -> "Full stack" as the way to run
# both applications, and launch.json is where that lives -- ignoring it makes the documented path
# impossible on a clean clone and 404s the README's own link. All four files are project
# configuration, not personal preference: no absolute paths, no secrets, ${workspaceFolder}
# throughout.
#
# The `.vscode/*` + `!` form is load-bearing, exactly as it is for the Gradle wrapper above: git
# does not descend into an excluded directory, so a negation under a bare `.vscode/` would never be
# reached and the files would stay invisible while looking un-ignored.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json

# OS
.DS_Store

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Probe fixtures, written by ProbeFixtureDumpTest. Outputs, not sources.
backend/tools/receptionist-probe/fixtures/

# stats.py lives in the repo and is meant to be run; running it makes these.
__pycache__/
*.pyc
