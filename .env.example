# ---------------------------------------------------------------------------
# Reception — local environment
#
# Copy to .env and adjust. Every variable docker-compose.yml reads is listed here, and the
# backend reads the same file when it runs from your IDE.
#
# `.env` is git-ignored; nothing in this file is a real credential.
#
# The prod profile refuses to start while JWT_SECRET, MANAGE_LINK_SECRET or DB_PASSWORD still
# holds its local default (SecretsGuard). It does NOT check MAIL_PASSWORD or OPENAI_API_KEY, and
# the omissions are deliberate rather than oversights: an empty SMTP password is legitimate, so
# the guard cannot tell "no auth needed" from "forgot it", and a placeholder OpenAI key is a
# working application — the Receptionist degrades to the Classic Flow. This said "any secret"
# until the audit on 2026-09-12, which was two-fifths wrong (docs/06-security.md §9 lists five).
# Deploying? Read docs/deployment.md §5 before trusting the guard: it has no test behind it.
# ---------------------------------------------------------------------------

# --- Ports --------------------------------------------------------------------
# One contiguous block, 9080-9085, deliberately away from the 3000/8080/5432 range so this
# project never collides with another one running at the same time.
#
#   lsof -nP -iTCP:9080-9085 -sTCP:LISTEN     # check the whole block at once
#
# Four of these are written down twice and the copies have to agree. `make check-ports` enforces
# all four and `make up` depends on it, so a half-moved port fails at the command rather than as
# a connection refused somewhere further in:
#
#   FRONTEND_PORT  = the port in frontend/package.json's `next dev --port`
#   POSTGRES_PORT  = DB_PORT           (while DB_HOST is local)
#   MAILPIT_SMTP_PORT = MAIL_PORT      (while MAIL_HOST is local)
#   APP_PORT       = the port inside APP_PUBLIC_URL
#
# SERVER_PORT is the exception, and it is not checked: the frontend's server-side fallback in
# src/lib/api/client.ts hardcodes http://localhost:9081/api for the `make up` topology, so moving
# SERVER_PORT means editing that literal too. A gate cannot read it out of .env.
#
# Caddy — the only origin a browser should ever use.
APP_PORT=9080
# The backend, running on your machine.
SERVER_PORT=9081
# The frontend, running on your machine. Caddy proxies here.
# Next.js ignores PORT from env files, so the frontend's own port is pinned in
# frontend/package.json. `make up` fails if the two disagree.
FRONTEND_PORT=9082
# Mailpit's web UI — read captured mail here.
MAILPIT_UI_PORT=9083
MAILPIT_SMTP_PORT=9084
POSTGRES_PORT=9085

# --- Database (container) ------------------------------------------------------
POSTGRES_DB=reception
POSTGRES_USER=reception
POSTGRES_PASSWORD=local-dev-only-postgres-password

# --- Backend -------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local

# The backend runs on the host, so it reaches Postgres and Mailpit through their published
# ports. `make up-all` overrides these with the compose service names.
DB_HOST=localhost
DB_PORT=9085
DB_NAME=reception
DB_USER=reception
DB_PASSWORD=local-dev-only-postgres-password

# HS256 signing secret for access tokens (phase 02). Minimum 32 bytes.
JWT_SECRET=local-dev-only-jwt-secret-change-me-please

# HMAC-SHA256 secret for Manage Links (phase 07). Minimum 32 bytes.
MANAGE_LINK_SECRET=local-dev-only-manage-link-secret-change-me

# --- Mail ----------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=9084
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@reception.local

# The outbox poller. Leave it on. Off means booking, cancelling and rescheduling still queue their
# emails — the rows are written in the same transaction either way — and nothing ever sends them.
NOTIFICATIONS_POLLER_ENABLED=true

# --- AI (phase 09) -------------------------------------------------------------
# The Receptionist degrades to the Classic Flow while this is the placeholder, which is deliberate:
# a clone with no key is a working application, not a failed startup. Set a real key to switch it on.
OPENAI_API_KEY=sk-local-dev-only-not-a-real-key
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint — a proxy, a gateway, a local model server.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30
# Used only to estimate spend against each business's daily cap. gpt-4o-mini's published prices;
# set them alongside OPENAI_MODEL if you change it.
OPENAI_PROMPT_CENTS_PER_MTOK=15
OPENAI_COMPLETION_CENTS_PER_MTOK=60

# The transcript retention purge (phase 11). Leave it on.
#
# An ai_message holds the customer's name and phone number as they typed them, and this switch is
# the only thing standing between that and being kept forever. It is a development switch — a suite
# that plants an aged conversation does not want a background thread deleting it — and NOT a way to
# extend the window.
#
# THE WINDOW IS NOT HERE, and its absence is the point. Ninety days lives in
# ConversationLimits.TRANSCRIPT_RETENTION_DAYS, because a retention window is a promise about other
# people's data and this is the file where it could be quietly widened to a year on one host by
# somebody who never opened a diff. Same rule as the rate limits below and the notification retry
# schedule above: the switch is configuration, the policy is not.
AI_RETENTION_ENABLED=true

# The per-endpoint rate limits. Leave them on. Off removes every bucket at once — it is a
# development and load-testing switch, not a tuning knob: the limits themselves are policy and live
# in RateLimitProperties, not here (docs/06-security.md §5).
RATE_LIMIT_ENABLED=true

# --- Application ---------------------------------------------------------------
# Origin the application builds absolute links from (Manage Links, emails). Always the Caddy
# origin, never the backend's own port — links must work in a browser.
APP_PUBLIC_URL=http://localhost:9080
LOG_LEVEL=INFO

# --- Security headers (phase 11) -----------------------------------------------
# Caddy sets the headers of docs/06-security.md §13. Two of them differ by environment and are
# therefore here rather than in the Caddyfile.
#
# CSP_SCRIPT_EXTRA is appended to the Content-Security-Policy's script-src. It is 'unsafe-eval'
# below because `make up` runs the frontend as `next dev`, which compiles modules through eval —
# without it the page still renders but the console fills with EvalError and hot reload is broken.
# `make up-all`, which is the containerised topology CI smoke-tests and the one that deploys,
# empties this in docker-compose.apps.yml and gets the policy as shipped. If you change nothing
# else in this file, leave it alone; if you deploy from it, it must be empty.
# The double quotes are load-bearing: a CSP keyword must reach Caddy with its single quotes
# intact, and Compose strips one layer. Written as 'unsafe-eval' this arrives as a bare token,
# which is a valid-looking policy naming a *host* called unsafe-eval and permits nothing.
CSP_SCRIPT_EXTRA="'unsafe-eval'"
# Strict-Transport-Security. A browser ignores it entirely on a response that did not arrive over
# HTTPS, so max-age=0 is the honest value for a local plain-HTTP origin. Behind TLS this becomes
# max-age=31536000; includeSubDomains — see docs/deployment.md.
HSTS=max-age=0
