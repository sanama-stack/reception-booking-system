# ---------------------------------------------------------------------------
# Reception — local environment
#
# Copy to .env and adjust. Every variable docker-compose.yml reads is listed here, and the
# backend reads the same file when it runs from your IDE.
#
# `.env` is git-ignored; nothing in this file is a real credential. The prod profile refuses to
# start while any secret still holds its local default.
# ---------------------------------------------------------------------------

# --- Ports --------------------------------------------------------------------
# One contiguous block, 9080-9085, deliberately away from the 3000/8080/5432 range so this
# project never collides with another one running at the same time.
#
#   lsof -nP -iTCP:9080-9085 -sTCP:LISTEN     # check the whole block at once
#
# Caddy — the only origin a browser should ever use.
APP_PORT=9080
# The backend, running on your machine.
SERVER_PORT=9081
# The frontend, running on your machine. Caddy proxies here.
# Next.js ignores PORT from env files, so the frontend's own port is pinned in
# frontend/package.json. `make up` fails if the two disagree.
FRONTEND_PORT=9082
# Mailpit's web UI — read captured mail here.
MAILPIT_UI_PORT=9083
MAILPIT_SMTP_PORT=9084
POSTGRES_PORT=9085

# --- Database (container) ------------------------------------------------------
POSTGRES_DB=reception
POSTGRES_USER=reception
POSTGRES_PASSWORD=local-dev-only-postgres-password

# --- Backend -------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local

# The backend runs on the host, so it reaches Postgres and Mailpit through their published
# ports. `make up-all` overrides these with the compose service names.
DB_HOST=localhost
DB_PORT=9085
DB_NAME=reception
DB_USER=reception
DB_PASSWORD=local-dev-only-postgres-password

# HS256 signing secret for access tokens (phase 02). Minimum 32 bytes.
JWT_SECRET=local-dev-only-jwt-secret-change-me-please

# HMAC-SHA256 secret for Manage Links (phase 07). Minimum 32 bytes.
MANAGE_LINK_SECRET=local-dev-only-manage-link-secret-change-me

# --- Mail ----------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=9084
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@reception.local

# The outbox poller. Leave it on. Off means booking, cancelling and rescheduling still queue their
# emails — the rows are written in the same transaction either way — and nothing ever sends them.
NOTIFICATIONS_POLLER_ENABLED=true

# --- AI (phase 09) -------------------------------------------------------------
OPENAI_API_KEY=sk-local-dev-only-not-a-real-key
OPENAI_MODEL=gpt-4o-mini

# --- Application ---------------------------------------------------------------
# Origin the application builds absolute links from (Manage Links, emails). Always the Caddy
# origin, never the backend's own port — links must work in a browser.
APP_PUBLIC_URL=http://localhost:9080
LOG_LEVEL=INFO
